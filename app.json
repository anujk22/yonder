{
  "expo": {
    "name": "Yonder",
    "slug": "yonder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/yonder-scout.png",
    "scheme": "yonder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/concepts/yonder-scout-green-3d-v2.png",
      "appleTeamId": "9C6DA2SDJ7",
      "bundleIdentifier": "com.anujkakumanu.yonder",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Yonder captures live observations in the app.",
        "NSLocationWhenInUseUsageDescription": "Yonder verifies you are at the location you are observing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F0",
        "foregroundImage": "./assets/brand/yonder-scout.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Yonder captures live observations in the app.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F0",
          "image": "./assets/brand/yonder-scout.png",
          "imageWidth": 148,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ccf2b54b-6734-43f5-8877-8a038e1c9703"
      }
    },
    "owner": "bluetrox"
  }
}

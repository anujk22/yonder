{
  "expo": {
    "name": "Yonder",
    "slug": "yonder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon/icon-light.png",
    "scheme": "yonder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/brand/icon/icon-light.png",
        "dark": "./assets/brand/icon/icon-dark.png",
        "tinted": "./assets/brand/icon/icon-tinted.png"
      },
      "appleTeamId": "9C6DA2SDJ7",
      "bundleIdentifier": "com.anujkakumanu.yonder",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Yonder uses your camera for the optional local device-check demo. Photos stay on your device and are not uploaded.",
        "NSLocationWhenInUseUsageDescription": "Yonder uses your location to center the map and check your position during the optional local device-check demo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3DD",
        "foregroundImage": "./assets/brand/icon/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Yonder uses your camera for the optional local device-check demo. Photos stay on your device and are not uploaded.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F0",
          "image": "./assets/brand/icon/splash.png",
          "imageWidth": 148,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ccf2b54b-6734-43f5-8877-8a038e1c9703"
      }
    },
    "owner": "bluetrox"
  }
}

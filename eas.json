{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "testflight-preview": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_YONDER_PREVIEW": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815955359"
      }
    }
  }
}
